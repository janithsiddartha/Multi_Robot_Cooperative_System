# rt_AI Multi-Robot Autonomous AI Configuration
# Modes: hybrid (auto-fallback), deterministic (100% offline), local (Ollama), cloud (OpenAI/Anthropic/Gemini)
AI_MODE=hybrid

# Execution Safety Policy: advisory, simulation, hardware
AI_EXECUTION_POLICY=advisory

# Local Ollama Server
OLLAMA_BASE_URL=http://localhost:11434
AI_MODEL_NAME=llama3

# Cloud LLM API Keys (Optional - deterministic engine operates seamlessly without keys)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=...

